{
    "task": "NC",
    "dataset": "senate-committees",
    "val_every": 5,
    "exp_iters": 10,
    "log_dir": "./logs/",
    "result_dir": "./results/",
    "task_model_path": "NC_CS_model.pt",
    "checkpoints": "./checkpoints/",
    "data_dir": "./datasets",
    "raw_data_dir": "./raw_data",
    "method": "HEAL",
    "add_self_loop": false,
    "n_layers": 5,
    "hid_dim": 512,
    "embed_dim": 512,
    "dropout": 0.25,
    "norm": "ln",
    "bias": true,
    "tau": 0.5,
    "act": "gelu",
    "layer_wise": true,
    "u": 1.0,
    "lam": 1.0,
    "input_dropout": 0.2,
    "train_prop": 0.5,
    "valid_prop": 0.25,
    "feature_noise": "1",
    "exclude_self": false,
    "lr_nc": 0.0003,
    "weight_decay_nc": 0,
    "epochs_nc": 2000,
    "patience_nc": 15,
    "use_gpu": true,
    "gpu": 0,
    "devices": "0,1"
}